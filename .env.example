# Supabase-Projekt (Project Settings → API). Der "anon"/"publishable" Key ist öffentlich und darf ins Frontend.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=DEIN_ANON_ODER_PUBLISHABLE_KEY
# Optional: Name der App in Kopfzeile und Browser-Tab
VITE_APP_NAME=Brandbench

# Nur für den MCP-Server (Claude-Konnektor, siehe docs/MCP.md). Auf Vercel nicht nötig:
# Der Server liest dieselben VITE_/NEXT_PUBLIC_-Werte wie die Web-App.
# SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# SUPABASE_ANON_KEY=DEIN_ANON_ODER_PUBLISHABLE_KEY
# Optional: Adresse der Web-App für Links in Antworten, öffentliche Adresse des MCP-Servers
# APP_URL=https://deine-app.vercel.app
# MCP_PUBLIC_URL=https://deine-app.vercel.app
